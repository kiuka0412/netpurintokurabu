<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>プリクラ風落書きWebカメラ</title>
<style>
  body { text-align:center; font-family:sans-serif; background:#ffe4f0; }
  video, canvas { border-radius:20px; margin-top:20px; }
  button, select, input { margin-top:10px; padding:10px; font-size:16px; }
</style>
</head>
<body>
<h1>プリクラ風落書きWebカメラ</h1>
<video id="video" width="320" height="240" autoplay></video>
<br>
<button id="snap">撮影📸</button>
<button id="save">保存💾</button>
<br>
<label>色: <input type="color" id="color" value="#ff00aa"></label>
<label>太さ: <input type="number" id="size" value="5" min="1" max="50"></label>
<canvas id="canvas" width="320" height="240"></canvas>

<script>
const video = document.getElementById('video');
const canvas = document.getElementById('canvas');
const context = canvas.getContext('2d');

let drawing = false;
let color = document.getElementById('color').value;
let size = parseInt(document.getElementById('size').value);

// カメラ起動
navigator.mediaDevices.getUserMedia({ video: true })
.then(stream => video.srcObject = stream)
.catch(err => alert('カメラが使えません: ' + err));

// 色・太さ変更
document.getElementById('color').addEventListener('input', e => color = e.target.value);
document.getElementById('size').addEventListener('input', e => size = parseInt(e.target.value));

// 撮影＋プリクラ風加工
document.getElementById('snap').addEventListener('click', () => {
    context.drawImage(video, 0, 0, canvas.width, canvas.height);

    // プリクラ風フィルター
    let imageData = context.getImageData(0,0,canvas.width,canvas.height);
    let data = imageData.data;
    for(let i=0;i<data.length;i+=4){
        data[i] = Math.min(data[i]*1.3,255);
        data[i+1] = Math.min(data[i+1]*1.2,255);
        data[i+2] = Math.min(data[i+2]*1.4,255);
        if(i>3 && i<data.length-4){
            data[i] = (data[i]+data[i-4]+data[i+4])/3;
            data[i+1] = (data[i+1]+data[i-3]+data[i+5])/3;
            data[i+2] = (data[i+2]+data[i-2]+data[i+6])/3;
        }
    }
    context.putImageData(imageData,0,0);

    // フレーム
    context.strokeStyle = 'pink';
    context.lineWidth = 8;
    context.strokeRect(0,0,canvas.width,canvas.height);

    // 日付・文字
    context.fillStyle='white';
    context.font='20px sans-serif';
    const today = new Date();
    context.fillText(today.getFullYear()+'/'+(today.getMonth()+1)+'/'+today.getDate(),10,canvas.height-10);
    context.fillText('💖 My Purikura 💖',70,30);
});

// 保存
document.getElementById('save').addEventListener('click', () => {
    const link = document.createElement('a');
    link.download = 'purikura.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
});

// 落書き機能
canvas.addEventListener('mousedown', e => { drawing = true; context.beginPath(); context.moveTo(e.offsetX, e.offsetY); });
canvas.addEventListener('mousemove', e => {
    if(drawing){
        context.strokeStyle = color;
        context.lineWidth = size;
        context.lineCap = 'round';
        context.lineTo(e.offsetX, e.offsetY);
        context.stroke();
    }
});
canvas.addEventListener('mouseup', () => drawing = false);
canvas.addEventListener('mouseleave', () => drawing = false);
</script>
</body>
</html>
